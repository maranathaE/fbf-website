# Copy to .env for local development, and set the same values in Vercel → Settings → Environment Variables.
# Everything is optional: without these the site builds from the bundled seed content,
# /admin explains how to connect the CMS, the brief form runs in demo mode and the live badge stays hidden.

PUBLIC_SITE_URL=https://fbf.studio

# Sanity (CMS). Create a project at sanity.io/manage.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Server-only token with Editor rights. Used to store brief submissions in the CMS.
SANITY_WRITE_TOKEN=

# Resend (email for the brief builder). The sending domain must be verified in Resend.
RESEND_API_KEY=
BRIEF_FROM_EMAIL=Frame by Frame <briefs@fbf.studio>

# YouTube Data API v3 key, used server-side for the live badge.
YOUTUBE_API_KEY=
