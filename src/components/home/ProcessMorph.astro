---
import { getProjects, getSettings } from '../../lib/content';

const { process } = await getSettings();
const projects = await getProjects();
const example = projects.find((p) => p.slug === process.projectSlug) ?? projects.find((p) => p.featured) ?? projects[0];
// the 960w variant is plenty for the canvas
const src = example.cover.srcset.split(', ').map((s) => s.split(' ')).find(([, w]) => parseInt(w) >= 960)?.[0] ?? example.cover.src;
---

<section class="morph" data-morph data-src={src} aria-labelledby="process-title">
  <div class="pin wrap">
    <div class="copy">
      <p class="eyebrow">How we work</p>
      <h2 id="process-title" class="mt-3 text-title">Concept, design, execution.</h2>
      <p class="mt-4 max-w-[38ch] text-ink-soft">{process.intro}</p>
      <ol class="mt-8 space-y-5">
        {
          process.stages.map((s, i) => (
            <li class="stage" data-stage>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-2xl">{s.title}</h3>
                <p class="mt-1 text-ink-soft">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <figure class="frame">
      <div class="sheet p-2.5">
        <div class="canvas-wrap">
          <canvas data-morph-canvas role="img" aria-label={`A frame from ${example.title}, redrawn as a pencil sketch, then flat colour, then the finished frame.`}></canvas>
          <span class="tag" aria-hidden="true" data-morph-label>SKETCH</span>
        </div>
        <div class="static" aria-hidden="true">
          {['Sketch', 'Flat colour', 'Final'].map((l) => (
            <div><canvas data-morph-static /><span>{l}</span></div>
          ))}
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-xs text-ink-soft">
        From <a class="link-pencil" href={`/work/${example.slug}`}>{example.title}</a>, {example.clientLabel}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .morph {
    position: relative;
    height: 320vh;
  }
  .pin {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: calc(var(--header-h) + 1rem) 2rem;
  }
  .stage {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    opacity: 0.45;
    transition: opacity 0.25s steps(3);
  }
  .stage.is-active {
    opacity: 1;
  }
  .stage .n {
    font: 600 0.8125rem/2.2 var(--font-mono);
    color: var(--magenta-ink);
  }
  .canvas-wrap {
    position: relative;
  }
  canvas[data-morph-canvas] {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 3px;
    background: var(--paper-shade);
  }
  .tag {
    position: absolute;
    left: 0.6rem;
    top: 0.6rem;
    padding: 0.25rem 0.45rem;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    font: 600 0.6875rem/1 var(--font-mono);
    letter-spacing: 0.1em;
  }
  .static {
    display: none;
  }
  .morph:global(.is-static) {
    height: auto;
  }
  .morph:global(.is-static) .pin {
    position: relative;
  }
  .morph:global(.is-static) .canvas-wrap {
    display: none;
  }
  .morph:global(.is-static) .static {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .morph:global(.is-static) .stage {
    opacity: 1;
  }
  .static canvas {
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .static span {
    font: 600 0.6875rem/2 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  @media (max-width: 860px) {
    .morph {
      height: 260vh;
    }
    .pin {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 1.25rem;
    }
    .frame {
      order: -1;
    }
    .stage p {
      display: none;
    }
    .copy > p {
      display: none;
    }
    .copy ol {
      margin-top: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .morph {
      height: auto;
    }
    .pin {
      position: relative;
    }
  }
</style>

<script>
  import { setupMorph } from '../../motion/morph';
  setupMorph();
</script>
