---
import CtaBand from '../components/CtaBand.astro';
import Picture from '../components/Picture.astro';
import Timeline from '../components/about/Timeline.astro';
import Base from '../layouts/Base.astro';
import { getSettings, getTeam, getTimeline } from '../lib/content';

const { about } = await getSettings();
const team = await getTeam();
const timeline = await getTimeline();
---

<Base title="About" description={about.history[0]}>
  <section class="wrap pb-12 pt-14 md:pt-20">
    <p class="eyebrow">About</p>
    <h1 class="mt-4 max-w-[15ch] text-display">A studio of people who draw, shoot and stream.</h1>
  </section>

  <section class="wrap grid gap-10 py-10 md:grid-cols-[1fr_2fr]" aria-labelledby="history-title">
    <h2 id="history-title" class="eyebrow self-start pt-2">Our history</h2>
    <div class="prose-fbf max-w-[60ch] text-lede">
      {about.history.map((p) => <p>{p}</p>)}
      <p class="mt-8 font-display text-[length:clamp(1.5rem,2.6vw,2.25rem)] leading-[1.2]">
        <span class="note">Our mission?</span> {about.mission}
      </p>
    </div>
  </section>

  <Timeline entries={timeline} />

  <section class="wrap py-16 md:py-24" aria-labelledby="team-title">
    <p class="eyebrow">The team</p>
    <h2 id="team-title" class="mt-3 text-title">The people behind every frame.</h2>
    <ul class="mt-10 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
      {
        team.map((m, i) => (
          <li class="member" style={`--tilt:${(i % 3) - 1}deg`}>
            <div class="photo">
              {m.photo ? (
                <Picture img={m.photo} sizes="(min-width: 1024px) 25vw, 50vw" class="aspect-square w-full object-cover" />
              ) : (
                <div class="aspect-square w-full bg-paper-shade" />
              )}
            </div>
            <h3 class="mt-3 font-sans text-base font-semibold tracking-normal">
              {m.name}
              {m.nickname && <span class="font-normal text-ink-soft"> "{m.nickname}"</span>}
            </h3>
            <p class="font-mono text-xs text-ink-soft">{m.role}</p>
            {m.bio && <p class="mt-2 text-sm text-ink-soft">{m.bio}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand title="Come and make something with us." />
</Base>

<style>
  .photo {
    padding: 0.4rem 0.4rem 1.4rem;
    background: var(--sheet);
    box-shadow: var(--shadow-sheet);
    border-radius: 3px;
    transform: rotate(var(--tilt));
    transition: transform 0.25s steps(3);
  }
  .member:hover .photo {
    transform: rotate(0deg) translateY(-3px);
  }
</style>
