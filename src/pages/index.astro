---
import CtaBand from '../components/CtaBand.astro';
import ClientMarquee from '../components/home/ClientMarquee.astro';
import Hero from '../components/home/Hero.astro';
import ProcessMorph from '../components/home/ProcessMorph.astro';
import Reel from '../components/home/Reel.astro';
import WorkGrid from '../components/work/WorkGrid.astro';
import Base from '../layouts/Base.astro';
import { getProjects, getServices, getSettings } from '../lib/content';

const settings = await getSettings();
const projects = await getProjects();
const services = await getServices();
const featured = projects.filter((p) => p.featured).slice(0, 6);
---

<Base>
  <Hero />

  <section class="wrap grid gap-6 py-20 md:grid-cols-[1fr_2fr] md:py-28" aria-labelledby="intro-title">
    <h2 id="intro-title" class="eyebrow self-start pt-3">A creative studio</h2>
    <p class="font-display text-[length:clamp(1.5rem,3vw,2.5rem)] leading-[1.2]">
      {settings.intro}
    </p>
  </section>

  <Reel />

  <section class="wrap py-16 md:py-24" aria-labelledby="work-title">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title" class="mt-3 text-title">Frames we're proud of.</h2>
      </div>
      <a href="/work" class="link-pencil font-semibold">All {projects.length} projects →</a>
    </div>
    <WorkGrid projects={featured} />
  </section>

  <ProcessMorph />

  <section class="wrap py-20 md:py-28" aria-labelledby="services-title">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow">Services</p>
      <h2 id="services-title" class="mt-3 text-title">Three ways we bring ideas to life.</h2>
    </div>
    <ul class="grid gap-5 md:grid-cols-3">
      {
        services.map((s, i) => (
          <li class="sheet flex flex-col p-6">
            <span class="font-mono text-xs font-semibold text-magenta-ink" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-3xl">{s.title}</h3>
            <p class="mt-3 flex-1 text-ink-soft">{s.summary}</p>
            <a href={`/services#${s.id}`} class="link-pencil mt-6 self-start font-semibold">
              More on {s.title.toLowerCase()} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <ClientMarquee />

  <CtaBand />
</Base>
