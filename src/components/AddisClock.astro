---
// Local time at the studio, in both clocks Addis keeps: the international 24-hour clock and
// Ethiopian time, which counts the 12 hours from 6 am. Plus whether the studio is open.
interface Props {
  hours: string;
}
const { hours } = Astro.props;
// "Mon–Fri, 9:00–18:30" → days 1–5, 09:00–18:30. Anything unparseable just hides the open/closed line.
const span = hours.match(/(\d{1,2}):(\d\d)\s*[–-]\s*(\d{1,2}):(\d\d)/);
const lastDay = /sat/i.test(hours) ? 6 : 5;
const open = span ? [Number(span[1]) * 60 + Number(span[2]), Number(span[3]) * 60 + Number(span[4])] : null;
---

<p class="clock" data-clock data-open={open?.join(',')} data-last-day={lastDay}>
  <span class="face" aria-hidden="true"><i data-hand></i></span>
  <span>
    <span class="block">In Addis it's <time data-time>--:--</time></span>
    <span class="block text-ink-soft"><span data-et>--:--</span> in Ethiopian time<span data-status></span></span>
  </span>
</p>

<style>
  .clock {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font: 400 0.8125rem/1.5 var(--font-mono);
  }
  .face {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .face i {
    position: absolute;
    left: calc(50% - 1px);
    bottom: 50%;
    width: 2px;
    height: 40%;
    background: var(--magenta);
    transform-origin: 50% 100%;
  }
  .face::after {
    content: '';
    position: absolute;
    inset: calc(50% - 3px);
    border-radius: 50%;
    background: var(--teal);
  }
</style>

<script>
  import { each } from '../motion/lifecycle';

  const parts = (d: Date) =>
    Object.fromEntries(
      new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Addis_Ababa', hour: '2-digit', minute: '2-digit', second: '2-digit', weekday: 'short', hourCycle: 'h23' })
        .formatToParts(d)
        .map((p) => [p.type, p.value]),
    );
  const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  each('[data-clock]', (el) => {
    const time = el.querySelector('[data-time]')!;
    const et = el.querySelector('[data-et]')!;
    const status = el.querySelector('[data-status]')!;
    const hand = el.querySelector<HTMLElement>('[data-hand]')!;
    const [openAt, closeAt] = (el.dataset.open ?? '').split(',').map(Number);
    const lastDay = Number(el.dataset.lastDay);
    const tick = () => {
      const p = parts(new Date());
      const h = Number(p.hour), m = Number(p.minute), s = Number(p.second);
      time.textContent = `${p.hour}:${p.minute}`;
      time.setAttribute('datetime', `${p.hour}:${p.minute}`);
      et.textContent = `${((h + 6) % 12) || 12}:${p.minute}`;
      // the second hand ticks on twos: 30 positions a minute
      hand.style.transform = `rotate(${Math.floor(s / 2) * 12}deg)`;
      if (openAt) {
        const day = days.indexOf(p.weekday), now = h * 60 + m;
        const isOpen = day >= 1 && day <= lastDay && now >= openAt && now < closeAt;
        status.textContent = isOpen ? ' · studio open' : ' · studio closed';
      }
    };
    tick();
    setInterval(tick, 1000);
  });
</script>
