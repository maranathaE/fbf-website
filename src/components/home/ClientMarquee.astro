---
// Client wall as two slow marquees running opposite ways. Hovering or focusing a logo pauses
// the row and opens a card with the work we made for that client.
import { getClients } from '../../lib/content';

const clients = (await getClients()).filter((c) => c.onWall && c.logo);
const half = Math.ceil(clients.length / 2);
const rows = [clients.slice(0, half), clients.slice(half)];
---

<section class="py-20 md:py-28" aria-labelledby="clients-title">
  <div class="wrap mb-10">
    <p class="eyebrow">Clients</p>
    <h2 id="clients-title" class="mt-3 text-title">Who we've drawn for.</h2>
  </div>

  {
    rows.map((row, r) => (
      <div class:list={['marquee', r === 1 && 'reverse']}>
        {[0, 1].map((copy) => (
          <ul class="track" aria-hidden={copy === 1 ? 'true' : undefined} inert={copy === 1 ? true : undefined}>
            {row.map((c) => (
              <li class="client">
                {c.projects.length > 0 ? (
                  <>
                    <button type="button" class="chip" aria-describedby={copy === 0 ? `client-${c.id}` : undefined}>
                      <img src={c.logo!.src} alt={c.name} width={c.logo!.width} height={c.logo!.height} loading="lazy" decoding="async" />
                    </button>
                    <div class="card" id={copy === 0 ? `client-${c.id}` : undefined} role="group" aria-label={c.name}>
                      <p class="name">{c.name}</p>
                      <ul class="projects">
                        {c.projects.map((p) => (
                          <li>
                            <a href={`/work/${p.slug}`}>{p.title}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                ) : (
                  <span class="chip">
                    <img src={c.logo!.src} alt={c.name} width={c.logo!.width} height={c.logo!.height} loading="lazy" decoding="async" />
                  </span>
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))
  }
</section>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    padding-block: 0.5rem 0.75rem;
    --speed: 60s;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee + .marquee {
    margin-top: 0.75rem;
  }
  .track {
    display: flex;
    flex: none;
    gap: 0.9rem;
    padding-right: 0.9rem;
    animation: slide var(--speed) linear infinite;
  }
  .reverse .track {
    animation-direction: reverse;
    --speed: 70s;
  }
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes slide {
    to {
      transform: translateX(-100%);
    }
  }
  .client {
    position: relative;
  }
  .chip {
    display: grid;
    place-items: center;
    width: 10.5rem;
    height: 6.5rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: #fbf8f1;
    box-shadow: var(--shadow-sheet);
    transition: transform 0.25s steps(3);
  }
  .chip img {
    max-height: 4.5rem;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  button.chip:hover,
  button.chip:focus-visible {
    transform: rotate(-1.5deg) translateY(-3px);
  }
  .card {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    z-index: 5;
    width: 15rem;
    padding: 0.9rem 1rem;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    translate: -50% 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.125s steps(2), translate 0.125s steps(2), visibility 0s 0.125s;
  }
  .client:hover .card,
  .client:focus-within .card {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
    transition-delay: 0s;
  }
  .name {
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .projects {
    margin-top: 0.4rem;
    display: grid;
    gap: 0.25rem;
  }
  .projects a {
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--teal) 70%, transparent);
    text-underline-offset: 0.2em;
  }
  /* The card sits above the row, so give the top row's cards room. */
  section {
    overflow: clip;
    overflow-clip-margin: 0;
  }
  .marquee {
    padding-top: 9rem;
    margin-top: -8.5rem;
  }
  .marquee + .marquee {
    margin-top: -8.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      flex-wrap: wrap;
      mask-image: none;
    }
    .track {
      animation: none;
      flex-wrap: wrap;
      flex: 1 1 100%;
      justify-content: center;
    }
    .track[aria-hidden='true'] {
      display: none;
    }
  }
</style>
