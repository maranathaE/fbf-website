---
import CtaBand from '../components/CtaBand.astro';
import Picture from '../components/Picture.astro';
import ProjectCard from '../components/work/ProjectCard.astro';
import Base from '../layouts/Base.astro';
import { getProjects, getServices, getSettings } from '../lib/content';

const services = await getServices();
const projects = await getProjects();
const { servicesIntro } = await getSettings();
const examples = (id: string) => projects.filter((p) => p.services.includes(id as never)).slice(0, 3);
---

<Base title="Services" description={servicesIntro}>
  <section class="wrap pb-12 pt-14 md:pt-20">
    <p class="eyebrow">Services</p>
    <h1 class="mt-4 max-w-[16ch] text-display">From the first sketch to the final frame.</h1>
    <p class="mt-6 max-w-[56ch] text-lede text-ink-soft">{servicesIntro}</p>
    <nav aria-label="Services on this page" class="mt-8 flex flex-wrap gap-2">
      {services.map((s) => <a href={`#${s.id}`} class="btn btn-ghost">{s.title}</a>)}
    </nav>
  </section>

  {
    services.map((s, i) => (
      <section id={s.id} class="wrap scroll-mt-24 border-t border-rule py-16 md:py-24" aria-labelledby={`${s.id}-title`}>
        <div class="grid gap-10 md:grid-cols-[1fr_1.4fr]">
          <div>
            <p class="font-mono text-xs font-semibold text-magenta-ink" aria-hidden="true">
              SC {String(i + 1).padStart(2, '0')}
            </p>
            <h2 id={`${s.id}-title`} class="mt-3 text-title">{s.title}</h2>
            <p class="mt-4 text-lede">{s.summary}</p>
            {s.icon && <Picture img={s.icon} sizes="240px" class="mt-8 hidden w-48 md:block" alt="" />}
          </div>
          <div>
            <p class="text-lede text-ink-soft">{s.body}</p>
            {s.formats.length > 0 && (
              <>
                <h3 class="eyebrow mt-10">What we make</h3>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {s.formats.map((f) => (
                    <li class="rounded-full bg-sheet px-3.5 py-1.5 text-sm font-semibold shadow-[var(--shadow-sheet)]">{f}</li>
                  ))}
                </ul>
              </>
            )}
            <div class="mt-10 flex items-center justify-between gap-4">
              <h3 class="eyebrow">Recent {s.title.toLowerCase()}</h3>
              <a href={`/work?service=${s.id}`} class="link-pencil text-sm font-semibold">See all →</a>
            </div>
          </div>
        </div>
        <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-work>
          {examples(s.id).map((p) => <ProjectCard project={p} />)}
        </ul>
      </section>
    ))
  }

  <CtaBand />
</Base>

<script>
  import { initWorkGrid } from '../motion/work-grid';
  initWorkGrid();
</script>
