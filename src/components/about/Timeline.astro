---
// Behind-the-scenes timeline, laid out like an exposure sheet: one column per moment.
import type { TimelineEntry } from '../../lib/types';
import Picture from '../Picture.astro';

interface Props {
  entries: TimelineEntry[];
}
const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="wrap py-16 md:py-24" aria-labelledby="timeline-title">
      <p class="eyebrow">Behind the scenes</p>
      <h2 id="timeline-title" class="mt-3 text-title">The exposure sheet.</h2>
      <ol class="sheetline mt-10" tabindex="0" aria-label="Timeline, scrolls sideways">
        {entries.map((e, i) => (
          <li class="entry">
            <p class="frame" aria-hidden="true">
              {String(i + 1).padStart(3, '0')}
            </p>
            <p class="date">{e.date}</p>
            {e.image && <Picture img={e.image} sizes="320px" class="mt-3 aspect-video w-full rounded-[3px] object-cover" alt="" />}
            <h3 class="mt-3 font-sans text-lg font-semibold tracking-normal">{e.title}</h3>
            {e.body && <p class="mt-1 text-sm text-ink-soft">{e.body}</p>}
            {e.project && (
              <a class="link-pencil mt-2 inline-block text-sm font-semibold" href={`/work/${e.project.slug}`}>
                See the project
              </a>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .sheetline {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 18rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    border-top: 2px solid var(--ink);
    padding-bottom: 1rem;
  }
  .entry {
    scroll-snap-align: start;
    padding: 0.75rem 1.25rem 0 0.9rem;
    border-left: 1px solid var(--rule);
    background-image: repeating-linear-gradient(transparent 0 23px, var(--rule) 23px 24px);
  }
  .frame {
    font: 600 0.6875rem/1 var(--font-mono);
    color: var(--magenta-ink);
  }
  .date {
    margin-top: 0.5rem;
    font: 400 1.75rem/1 var(--font-display);
  }
</style>
