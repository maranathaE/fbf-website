---
import type { Project, ServiceId } from '../../lib/types';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
  filters?: boolean;
  /** Load the first card eagerly (the grid starts near the top of the page). */
  eager?: boolean;
}
const { projects, filters = false, eager = false } = Astro.props;
const options: { id: 'all' | ServiceId; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'animation', label: 'Animation' },
  { id: 'production', label: 'Production' },
  { id: 'live', label: 'Live' },
];
const count = (id: string) => (id === 'all' ? projects.length : projects.filter((p) => p.services.includes(id as ServiceId)).length);
---

<div data-work>
  {
    filters && (
      <div class="mb-8 flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects by service">
        {options.map((o) => (
          <button type="button" class="chip" data-filter={o.id} aria-pressed={o.id === 'all' ? 'true' : 'false'}>
            {o.label}
            <span class="count" aria-hidden="true">{String(count(o.id)).padStart(2, '0')}</span>
          </button>
        ))}
        <p class="sr-only" role="status" data-filter-status />
      </div>
    )
  }
  <ul class="grid gap-x-5 gap-y-7 sm:grid-cols-2 lg:grid-cols-3" data-grid>
    {projects.map((p, i) => <ProjectCard project={p} priority={eager && i === 0} />)}
  </ul>
</div>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--rule);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background-color 0.125s steps(2), box-shadow 0.125s steps(2);
  }
  .chip:hover {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }
  .count {
    font: 500 0.6875rem/1 var(--font-mono);
    opacity: 0.7;
  }
</style>

<script>
  import { initWorkGrid } from '../../motion/work-grid';
  initWorkGrid();
</script>
