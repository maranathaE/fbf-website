---
import type { Img } from '../../lib/types';
import Picture from '../Picture.astro';

interface Props {
  frames: Img[];
  title: string;
}
const { frames, title } = Astro.props;
---

{
  frames.length > 1 && (
    <section class="onion skins-on" aria-labelledby="frames-title" data-onion>
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow">Frames</p>
          <h2 id="frames-title" class="mt-2 text-3xl">On the lightbox</h2>
        </div>
        <p class="font-mono text-xs text-ink-soft" aria-hidden="true">
          <span class="swatch prev" /> previous · <span class="swatch next" /> next
        </p>
      </div>

      <div class="sheet p-2.5 md:p-3">
        <div class="stage" tabindex="0" aria-label={`Frames from ${title}. Use the left and right arrow keys to step through them.`} data-onion-stage>
          {frames.map((f, i) => (
            <div class="frame" data-onion-frame>
              <Picture img={f} sizes="(min-width: 1200px) 1100px, 100vw" alt={f.alt} />
            </div>
          ))}
          <span class="counter" aria-hidden="true" data-onion-counter />
        </div>

        <div class="controls">
          <button type="button" class="ctl" data-onion-prev aria-label="Previous frame">←</button>
          <button type="button" class="ctl wide" data-onion-play aria-pressed="false">
            <span data-label>Play</span>
          </button>
          <button type="button" class="ctl" data-onion-next aria-label="Next frame">→</button>
          <label class="scrub">
            <span class="sr-only">Frame</span>
            <input type="range" min="1" max={frames.length} value="1" step="1" data-onion-range />
          </label>
          <button type="button" class="ctl wide" data-onion-skins aria-pressed="true">Onion skins</button>
        </div>

        <ol class="thumbs" aria-label="All frames">
          {frames.map((f, i) => (
            <li>
              <button type="button" data-onion-thumb aria-label={`Frame ${i + 1}`}>
                <img src={f.srcset.split(', ')[0].split(' ')[0]} alt="" width="160" height="90" loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ol>
      </div>
      <p class="sr-only" aria-live="polite" data-onion-caption />
    </section>
  )
}

<style>
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 3px;
    background: #fbf8f1;
  }
  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .frame[data-state='current'] {
    opacity: 1;
    z-index: 2;
  }
  .skins-on .frame[data-state='current'] {
    mix-blend-mode: multiply;
    opacity: 0.88;
  }
  .skins-on .frame[data-state='prev'] {
    opacity: 0.4;
    z-index: 1;
    filter: grayscale(1) sepia(1) hue-rotate(185deg) saturate(4) brightness(1.1);
    transform: translateX(-1.5%);
  }
  .skins-on .frame[data-state='next'] {
    opacity: 0.28;
    z-index: 1;
    filter: grayscale(1) sepia(1) hue-rotate(290deg) saturate(5) brightness(1.05);
    transform: translateX(1.5%);
  }
  .onion:global(.skins-off) .frame[data-state='current'] {
    opacity: 1;
    mix-blend-mode: normal;
  }
  .counter {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 3;
    padding: 0.25rem 0.45rem;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    font: 600 0.6875rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .ctl {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--rule);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .ctl:hover {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .ctl[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .scrub {
    flex: 1 1 10rem;
    display: flex;
  }
  .scrub input {
    width: 100%;
    accent-color: var(--magenta-ink);
    min-height: 2.75rem;
  }
  .thumbs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 5.5rem;
    gap: 0.35rem;
    margin-top: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .thumbs button {
    display: block;
    width: 100%;
    border-radius: 3px;
    overflow: hidden;
    outline-offset: -3px;
    opacity: 0.6;
  }
  .thumbs button[aria-current='true'] {
    opacity: 1;
    box-shadow: 0 0 0 2.5px var(--magenta);
  }
  .thumbs img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .swatch {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    vertical-align: -0.1rem;
  }
  .swatch.prev {
    background: var(--pencil);
  }
  .swatch.next {
    background: var(--magenta);
  }
</style>

<script>
  import { initOnion } from '../../motion/onion';
  document.querySelectorAll<HTMLElement>('[data-onion]').forEach(initOnion);
</script>
